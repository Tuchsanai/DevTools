pipeline {
  agent any

  parameters {
    string(name: 'APP_VERSION', defaultValue: '1.0.0',
           description: 'เวอร์ชันที่จะฝังเข้า image และแสดงบนหน้าเว็บ')
  }

  environment {
    APP_SRC     = '/lab/catfood-shop'   // source ที่ mount เข้า Jenkins แบบอ่านอย่างเดียว
    APP_NAME    = 'catfood-shop'        // ชื่อ repository บน Docker Hub
    DEPLOY_NAME = 'catfood-web'         // ชื่อ container ของเว็บที่ deploy แล้ว
    VERSION     = "${params.APP_VERSION}" // ใช้ค่า default ได้ตั้งแต่ build แรก
  }

  stages {
    stage('Prepare source') {
      steps {
        sh '''
          rm -rf app
          cp -r "$APP_SRC" app
          ls app
        '''
      }
    }

    stage('Build image') {
      steps {
        sh '''
          docker build \
            --build-arg APP_VERSION="$VERSION" \
            --build-arg BUILD_NUMBER="$BUILD_NUMBER" \
            --build-arg BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            -t "$APP_NAME:$BUILD_NUMBER" app
          docker image ls "$APP_NAME:$BUILD_NUMBER"
        '''
      }
    }

    stage('Test image') {
      steps {
        sh '''
          name="catfood-test-$BUILD_NUMBER"
          trap 'docker rm -f "$name" >/dev/null 2>&1 || true' EXIT
          docker run -d --name "$name" --network cicd-net "$APP_NAME:$BUILD_NUMBER"
          curl -fsS --retry 20 --retry-connrefused --retry-delay 1 \
            "http://$name:3000/api/health"
        '''
      }
    }

    stage('Push') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub',
            usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_TOKEN')]) {
          sh '''set +x
            export DOCKER_CONFIG=$(mktemp -d)
            trap 'docker logout >/dev/null 2>&1; rm -rf "$DOCKER_CONFIG"' EXIT
            echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
            for tag in "$BUILD_NUMBER" latest; do
              docker tag "$APP_NAME:$BUILD_NUMBER" "docker.io/$DOCKER_USER/$APP_NAME:$tag"
              docker push "docker.io/$DOCKER_USER/$APP_NAME:$tag"
            done
          '''
        }
      }
    }

    stage('Pull & Deploy') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub',
            usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_TOKEN')]) {
          sh '''
            image="docker.io/$DOCKER_USER/$APP_NAME:$BUILD_NUMBER"
            docker image rm "$image" "docker.io/$DOCKER_USER/$APP_NAME:latest"
            docker pull "$image"
            docker rm -f "$DEPLOY_NAME" 2>/dev/null || true
            docker run -d --name "$DEPLOY_NAME" --restart unless-stopped \
              --network cicd-net -p 3000:3000 "$image"
            curl -fsS --retry 20 --retry-connrefused --retry-delay 1 \
              "http://$DEPLOY_NAME:3000/api/health" | grep "\\"build\\":\\"$BUILD_NUMBER\\""
          '''
        }
      }
    }
  }

  post {
    success {
      echo "เปิดร้านได้ที่ http://localhost:3000 (catfood-shop v${params.APP_VERSION} build #${env.BUILD_NUMBER})"
    }
  }
}
