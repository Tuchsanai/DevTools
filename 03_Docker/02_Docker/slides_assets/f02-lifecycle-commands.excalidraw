    },
    {
      "id": "msq2hgum7w0tvkjbfox",
      "type": "text",
      "x": 40,
      "y": 460,
      "width": 346,
      "height": 22,
      "strokeColor": "#2f9e44",
      "text": "docker ps        shows RUNNING only",
      "fontSize": 18,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:30:10.321Z",
      "updatedAt": "2026-08-12T12:30:10.321Z",
      "version": 1
    },
    {
      "id": "msq2hgumuv84lzz0x8d",
      "type": "text",
      "x": 40,
      "y": 492,
      "width": 891,
      "height": 22,
      "strokeColor": "#e8590c",
      "text": "docker ps -a     shows RUNNING and EXITED   —  this is where 'my container vanished' hides",
      "fontSize": 18,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:30:10.321Z",
      "updatedAt": "2026-08-12T12:30:10.321Z",
      "version": 1
    },
    {
      "id": "msq2hgum05mrlylr88vy",
      "type": "text",
      "x": 40,
      "y": 530,
      "width": 1039,
      "height": 22,
      "strokeColor": "#343a40",
      "text": "stop  keeps the container and everything written inside it.    rm  destroys that writable layer for good.",
      "fontSize": 18,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:30:10.321Z",
      "updatedAt": "2026-08-12T12:30:10.321Z",
      "version": 1
    }
