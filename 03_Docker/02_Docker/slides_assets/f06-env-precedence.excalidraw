    {
      "id": "msq2ptuh98f2lnevc3g",
      "type": "text",
      "x": 150,
      "y": 480,
      "width": 867,
      "height": 23,
      "strokeColor": "#343a40",
      "text": "docker run  -e APP_COLOR=green  --env-file env/red.env  -p 8081:8081  color-app:1.0",
      "fontSize": 19,
      "fontFamily": 3,
      "createdAt": "2026-08-12T12:36:40.412Z",
      "updatedAt": "2026-08-12T12:36:40.412Z",
      "version": 1
    },
    {
      "id": "msq2ptuh435ck5gn4j",
      "type": "text",
      "x": 150,
      "y": 520,
      "width": 961,
      "height": 23,
      "strokeColor": "#343a40",
      "text": "ENV in the Dockerfile is a DEFAULT, never a lock — anyone running your image can replace it.",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:36:40.412Z",
      "updatedAt": "2026-08-12T12:36:40.412Z",
      "version": 1
    },
    {
      "id": "msq2ptuhchomx43xcx",
      "type": "text",
      "x": 150,
      "y": 552,
      "width": 1076,
      "height": 23,
      "strokeColor": "#c92a2a",
      "text": "Secrets do not belong in ENV or ARG :  docker inspect  and  docker history  print every value back out.",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:36:40.412Z",
      "updatedAt": "2026-08-12T12:36:40.412Z",
      "version": 1
    }
