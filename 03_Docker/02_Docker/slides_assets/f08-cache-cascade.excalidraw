    },
    {
      "id": "msq2n83w44jb0f80w9m",
      "type": "text",
      "x": 60,
      "y": 560,
      "width": 564,
      "height": 22,
      "strokeColor": "#c92a2a",
      "text": "the expensive layer  —  every dependency downloaded again",
      "fontSize": 18,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:34:38.927Z",
      "updatedAt": "2026-08-12T12:34:38.927Z",
      "version": 1
    },
    {
      "id": "msq2n83wn07uej8vy2",
      "type": "text",
      "x": 780,
      "y": 560,
      "width": 504,
      "height": 22,
      "strokeColor": "#2f9e44",
      "text": "the expensive layer stays cached  —  pip never runs",
      "fontSize": 18,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:34:38.927Z",
      "updatedAt": "2026-08-12T12:34:38.927Z",
      "version": 1
    },
    {
      "id": "msq2n83wm86092v33t",
      "type": "text",
      "x": 60,
      "y": 606,
      "width": 1408,
      "height": 25,
      "strokeColor": "#343a40",
      "text": "Rule :  one layer changes  ->  every layer BELOW it is rebuilt.  So put what changes least at the top and your source code LAST.",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:34:38.927Z",
      "updatedAt": "2026-08-12T12:34:38.927Z",
      "version": 1
    }
  ],
