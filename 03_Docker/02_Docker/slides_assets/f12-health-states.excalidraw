    {
      "id": "cmd",
      "type": "rectangle",
      "x": 70,
      "y": 348,
      "width": 1270,
      "height": 66,
      "backgroundColor": "#d0ebff",
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 1,
      "label": {
        "text": "HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=5s CMD curl -fs http://localhost:8080/healthz || exit 1"
      },
      "fontSize": 16,
      "fontFamily": 3,
      "fillStyle": "solid",
      "createdAt": "2026-08-12T12:37:42.152Z",
      "updatedAt": "2026-08-12T12:37:42.152Z",
      "version": 1
    },
    {
      "id": "msq2r5hhprmrdrusj8",
      "type": "text",
      "x": 70,
      "y": 448,
      "width": 1348,
      "height": 23,
      "strokeColor": "#343a40",
      "text": "A health check only reports.  To act on it you need  restart: unless-stopped  (the container is restarted when its process EXITS)",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:37:42.152Z",
      "updatedAt": "2026-08-12T12:37:42.152Z",
      "version": 1
    },
    {
      "id": "msq2r5hhc1jxxo4d7lv",
      "type": "text",
      "x": 70,
      "y": 482,
      "width": 1212,
      "height": 23,
      "strokeColor": "#343a40",
      "text": "or  depends_on:  condition: service_healthy  so a second service refuses to start until this one is genuinely ready.",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:37:42.152Z",
      "updatedAt": "2026-08-12T12:37:42.152Z",
      "version": 1
    },
    {
      "id": "msq2r5hhx0ip3kcjfoe",
      "type": "text",
      "x": 70,
      "y": 522,
      "width": 867,
      "height": 23,
      "strokeColor": "#c92a2a",
      "text": "Exited (137)  +  OOMKilled=true   ->  it did not crash, the memory limit killed it.",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T12:37:42.152Z",
      "updatedAt": "2026-08-12T12:37:42.152Z",
      "version": 1
    }
  ],
