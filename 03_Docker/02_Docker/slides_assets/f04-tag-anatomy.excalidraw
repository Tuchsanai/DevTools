      "version": 1
    },
    {
      "id": "msq40upwi5lf3e5nma",
      "type": "text",
      "x": 60,
      "y": 432,
      "width": 1348,
      "height": 23,
      "strokeColor": "#c92a2a",
      "text": "latest  is not a version.  It is the DEFAULT tag name, and the publisher can repoint it at a different image whenever they like —",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T13:13:14.374Z",
      "updatedAt": "2026-08-12T13:13:14.374Z",
      "version": 1
    },
    {
      "id": "msq40upw1rpsveg64fh",
      "type": "text",
      "x": 60,
      "y": 462,
      "width": 1180,
      "height": 23,
      "strokeColor": "#c92a2a",
      "text": "so the same command can build something different tomorrow.  Pin a real tag and every machine gets the same bits.",
      "fontSize": 19,
      "fontFamily": 2,
      "createdAt": "2026-08-12T13:13:14.374Z",
      "updatedAt": "2026-08-12T13:13:14.374Z",
      "version": 1
    },
    {
      "id": "msq40upwuegvhdzdb2b",
      "type": "text",
      "x": 60,
      "y": 506,
      "width": 1206,
      "height": 21,
      "strokeColor": "#6741d9",
      "text": "nginx@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de   <- a digest is the only truly immutable reference",
      "fontSize": 17,
      "fontFamily": 3,
      "createdAt": "2026-08-12T13:13:14.374Z",
      "updatedAt": "2026-08-12T13:13:14.374Z",
      "version": 1
    }
  ],
