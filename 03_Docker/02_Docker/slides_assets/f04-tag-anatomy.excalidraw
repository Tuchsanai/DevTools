    },
    {
      "id": "msq40upw4j676qgz9y6",
      "type": "arrow",
      "x": 535,
      "y": 375,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": {
        "type": 2
      },
      "points": [
        [
          0,
          0
        ],
        [
