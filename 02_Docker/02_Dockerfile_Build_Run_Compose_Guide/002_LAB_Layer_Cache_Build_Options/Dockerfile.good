# ใช้อิมเมจ Python รุ่นเล็กเป็นฐาน
FROM python:3.12-slim
# กำหนดโฟลเดอร์ทำงานภายในคอนเทนเนอร์
WORKDIR /app
# คัดลอกรายการ dependency ก่อนเพื่อใช้ cache
COPY requirements.txt .
# ติดตั้ง dependency ที่ระบุไว้
RUN pip install --no-cache-dir -r requirements.txt
# คัดลอก source code หลังติดตั้ง dependency
COPY . .
# กำหนดรหัส build สำหรับตัวอย่างแบบดี
ENV BUILD_ID=good-1
# ระบุพอร์ตที่แอปใช้งาน
EXPOSE 8182
# สั่งรัน Flask app เมื่อเริ่มคอนเทนเนอร์
CMD ["python","app.py"]
