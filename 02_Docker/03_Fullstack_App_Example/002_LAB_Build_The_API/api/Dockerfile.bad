# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------
# CampusOps API image — "ฉบับเทียบ" ที่เรียงลำดับไม่ดี  (LAB 2 การทดลองที่ 4)
#
# คำสั่งทุกบรรทัดเหมือน Dockerfile ตัวจริงทุกประการ ต่างกันแค่ "ลำดับ" :
#   ตัวจริง : COPY requirements.txt  →  RUN pip install  →  COPY main.py
#   ไฟล์นี้ : COPY . .               →  RUN pip install
# ไฟล์นี้มีไว้ให้เห็นราคาของการเรียงผิดลำดับด้วยตาตัวเอง ไม่ใช่ไฟล์ที่ใช้งานจริง
# ---------------------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# คัดลอกทุกไฟล์เข้ามาก่อน — main.py ที่แก้ทุกวันจึงอยู่ "เหนือ" ขั้นติดตั้ง dependency
COPY . .

# ขั้นแพงที่สุดมาอยู่ใต้ไฟล์ที่เปลี่ยนบ่อย → แก้โค้ดบรรทัดเดียวก็ต้องติดตั้งใหม่ทั้งชุด
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
