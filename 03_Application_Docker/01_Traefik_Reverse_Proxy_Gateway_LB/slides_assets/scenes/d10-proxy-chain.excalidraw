      "x": 292,
      "y": 344,
      "strokeColor": "#c2410c",
      "text": "ฝั่ง client เป็นเจ้าของ",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "createdAt": "2026-08-15T16:01:14.478Z",
