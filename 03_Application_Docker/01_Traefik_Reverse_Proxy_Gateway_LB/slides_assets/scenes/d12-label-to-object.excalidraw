    {
      "id": "l1",
      "type": "text",
      "x": 62,
      "y": 148,
      "strokeColor": "#1769aa",
      "text": "traefik.enable = true",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "createdAt": "2026-08-15T16:05:53.671Z",
      "updatedAt": "2026-08-15T16:05:53.671Z",
      "version": 1
    },
    {
      "id": "l2",
      "type": "text",
      "x": 62,
      "y": 186,
      "strokeColor": "#c2410c",
      "text": "traefik.http.routers.myapp.rule\n        = PathPrefix(`/app`)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "createdAt": "2026-08-15T16:05:53.671Z",
