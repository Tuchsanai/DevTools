      "version": 1
    },
    {
      "id": "l3",
      "type": "text",
      "x": 62,
      "y": 254,
      "strokeColor": "#6741d9",
      "text": "traefik.http.middlewares.stamp\n        .headers.customresponseheaders.X = Y",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "createdAt": "2026-08-15T16:05:53.671Z",
