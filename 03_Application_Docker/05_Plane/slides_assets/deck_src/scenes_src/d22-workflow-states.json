id": "custom", "type": "rectangle", "x": 430, "y": 336, "width": 180, "height": 50, "backgroundColor": "#ffffff", "strokeColor": "#5b6b7f", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 12, "text": "+ Testing …\n(เพิ่มเองได้)", "strokeStyle": "dashed"}, {"id": "done", "type": "rectangle", "x": 720, "y": 266, "width": 170, "height": 50, "backgroundColor": "#ebfbee", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "Done"}, {"id": "anysrc", "type": "rectangle", "x": 1010, "y": 160, "width": 150, "height": 50, "backgroundColor": "#ffffff", "strokeColor": "#5b6b7f", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 13, "text": "จาก state ใดก็ได้", "strokeStyle": "dashed"}, {"id": "can", "type": "rectangle", "x": 1010, "y": 266, "width": 150, "height": 50, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "Cancelled"}, {"id": "co1", "type": "rectangle", "x": 710, "y": 150, "width": 245, "height": 62, "backgroundColor": "#ffffff", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 13, "text": "เข้า group นี้\n→ ตั้ง completed_at\n(ใช้คำนวณ burndown)", "strokeStyle": "dashed"}, {"id": "co2", "type": "rectangle", "x": 655, "y": 336, "width": 300, "height": 62, "backgroundColor": "#ffffff", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 13, "text": "ออกจาก completed →\ncompleted_at กลับเป็นค่าว่าง\n(ไม่นับว่าเสร็จอีก)", "strokeStyle": "dashed"}, {"type": "arrow", "x": 0, "y": 0, "width": 60, "height": 0, "startElementId": "bl", "endElementId": "todo", "strokeColor": "#1864ab", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 0, "y": 0, "width": 60, "height": 0, "startElementId": "todo", "endElementId": "inp", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 0, "y": 0, "width": 60, "height": 0, "startElementId": "inp", "endElementId": "rev", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 0, "startArrowhead": "arrow"}, {"type": "arrow", "x": 0, "y": 0, "width": 60, "height": 0, "startElementId": "rev", "endElementId": "done", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 0, "y": 0, "width": 60, "height": 0, "startElementId": "done", "endElementId": "inp", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 0, "strokeStyle": "dashed"}, {"type": "arrow", "x": 0, "y": 0, "width": 60, "height": 0, "startElementId": "anysrc", "endElementId": "can", "strokeColor": "#c92a2a", "strokeWidth": 2, "roughness": 0, "strokeStyle": "dashed"}, {"type": "text", "x": 538, "y": 226, "text": "ส่ง review\nส่งกลับแก้", "fontSize": 14, "fontFamily": "helvetica", "strokeColor": "#e8590c", "textAlign": "left"}, {"type": "text", "x": 620, "y": 261, "text": "ผ่าน review", "fontSize": 14, "fontFamily": "helvetica", "strokeColor": "#2f9e44"}, {"type": "text", "x": 653, "y": 207, "text": "reopen", "fontSize": 14, "fontFamily": "helvetica", "strokeColor": "#e8590c"}, {"id": "pol", "type": "rectangle", "x": 30, "y": 430, "width": 590, "height": 100, "backgroundColor": "#f3f0ff", "strokeColor": "#6741d9", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 14, "text": "Policies = ข้อตกลงของทีม (Plane ไม่บังคับ → เขียนไว้ใน Page)\n• เข้า In Review ต้องมี PR link\n• เข้า Done ต้องผ่าน acceptance criteria ครบทุกข้อ\n• WIP ใน In Progress ≤ 3 ใบ/คน"}, {"id": "cmp", "type": "rectangle", "x": 645, "y": 430, "width": 535, "height": 100, "backgroundColor": "#e3fafc", "strokeColor": "#0b7285", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 14, "text": "เทียบกับ Jira\nJira: ตั้ง transition + condition / validator ได้\nPlane: มีแค่ state + group → เรียบง่าย แต่ทีมต้องมีวินัย"}, {"id": "ce", "type": "rectangle", "x": 30, "y": 548, "width": 1150, "height": 48, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "Plane CE: ลากไป state ใดก็ได้ — ไม่มี transition rule / WIP limit → ทีมเขียน policy เอง"}]