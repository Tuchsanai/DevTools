[{"type": "text", "x": 30, "y": 18, "text": "ACM/IEEE-CS Software Engineering Code of Ethics — 8 หลักการ", "fontSize": 28, "fontFamily": "helvetica", "strokeColor": "#0b2545"}, {"id": "e0", "type": "rectangle", "x": 40, "y": 90, "width": 265, "height": 185, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "1. PUBLIC\n\nทำเพื่อประโยชน์สาธารณะ\nปลอดภัย · ไม่หลอกลวง"}, {"id": "e1", "type": "rectangle", "x": 330, "y": 90, "width": 265, "height": 185, "backgroundColor": "#ffe8cc", "strokeColor": "#e8590c", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "2. CLIENT & EMPLOYER\n\nซื่อสัตย์ต่อลูกค้า/นายจ้าง\nโดยไม่ขัดประโยชน์สาธารณะ"}, {"id": "e2", "type": "rectangle", "x": 620, "y": 90, "width": 265, "height": 185, "backgroundColor": "#d0ebff", "strokeColor": "#1864ab", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "3. PRODUCT\n\nส่งมอบตามมาตรฐานสูงสุด\nเท่าที่ทำได้ · ทดสอบ · เอกสาร"}, {"id": "e3", "type": "rectangle", "x": 910, "y": 90, "width": 265, "height": 185, "backgroundColor": "#f3f0ff", "strokeColor": "#6741d9", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "4. JUDGMENT\n\nตัดสินใจอย่างเป็นอิสระ\nด้วยหลักวิชาชีพ"}, {"id": "e4", "type": "rectangle", "x": 40, "y": 305, "width": 265, "height": 185, "backgroundColor": "#e3fafc", "strokeColor": "#0b7285", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "5. MANAGEMENT\n\nบริหารด้วยจริยธรรม\nประเมินเวลา/ต้นทุนตามจริง"}, {"id": "e5", "type": "rectangle", "x": 330, "y": 305, "width": 265, "height": 185, "backgroundColor": "#ebfbee", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "6. PROFESSION\n\nรักษาชื่อเสียงวิชาชีพ\nรายงานข้อผิดพลาด"}, {"id": "e6", "type": "rectangle", "x": 620, "y": 305, "width": 265, "height": 185, "backgroundColor": "#f1f3f5", "strokeColor": "#5b6b7f", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "7. COLLEAGUES\n\nยุติธรรมและสนับสนุน\nเพื่อนร่วมงาน · รีวิวกันอย่างสร้างสรรค์"}, {"id": "e7", "type": "rectangle", "x": 910, "y": 305, "width": 265, "height": 185, "backgroundColor": "#ffdeeb", "strokeColor": "#a61e4d", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 15, "text": "8. SELF\n\nเรียนรู้ตลอดชีวิต\nและยึดจริยธรรมในทุกงาน"}, {"type": "text", "x": 40, "y": 525, "text": "ใน tracker: ประเมินตามจริง (5) · บันทึกการตัดสินใจไว้ใน work item (4) · รายงาน bug ทันที (6) · review อย่างสุภาพใน comment (7)", "fontSize": 15, "fontFamily": "helvetica", "strokeColor": "#5b6b7f"}]