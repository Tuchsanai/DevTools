[{"type": "text", "x": 30, "y": 18, "text": "Waterfall vs Agile : เมื่อไรที่ลูกค้าได้เห็นของจริง", "fontSize": 28, "fontFamily": "helvetica", "strokeColor": "#0b2545"}, {"type": "rectangle", "x": 30, "y": 75, "width": 1150, "height": 190, "backgroundColor": "#fff5f5", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0}, {"type": "text", "x": 50, "y": 85, "text": "Waterfall — ส่งต่อทีละขั้น ได้ feedback เมื่อจบทั้งสาย (หลายเดือน)", "fontSize": 18, "fontFamily": "helvetica", "strokeColor": "#c92a2a"}, {"id": "w1", "type": "rectangle", "x": 55, "y": 125, "width": 200, "height": 60, "backgroundColor": "#d0ebff", "strokeColor": "#1864ab", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Requirements"}, {"id": "w2", "type": "rectangle", "x": 280, "y": 140, "width": 200, "height": 60, "backgroundColor": "#d0ebff", "strokeColor": "#1864ab", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Design"}, {"id": "w3", "type": "rectangle", "x": 505, "y": 155, "width": 200, "height": 60, "backgroundColor": "#d0ebff", "strokeColor": "#1864ab", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Implement"}, {"id": "w4", "type": "rectangle", "x": 730, "y": 170, "width": 200, "height": 60, "backgroundColor": "#d0ebff", "strokeColor": "#1864ab", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Test"}, {"id": "w5", "type": "rectangle", "x": 955, "y": 185, "width": 200, "height": 60, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Release"}, {"type": "arrow", "x": 255, "y": 160, "width": 25, "height": 10, "startElementId": "w1", "endElementId": "w2", "strokeColor": "#5b6b7f", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 480, "y": 175, "width": 25, "height": 10, "startElementId": "w2", "endElementId": "w3", "strokeColor": "#5b6b7f", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 705, "y": 190, "width": 25, "height": 10, "startElementId": "w3", "endElementId": "w4", "strokeColor": "#5b6b7f", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 930, "y": 205, "width": 25, "height": 10, "startElementId": "w4", "endElementId": "w5", "strokeColor": "#5b6b7f", "strokeWidth": 2, "roughness": 0}, {"type": "text", "x": 560, "y": 232, "text": "ความเสี่ยง: รู้ว่าผิดโจทย์ตอนท้ายสุด แก้แพงที่สุด", "fontSize": 15, "fontFamily": "helvetica", "strokeColor": "#c92a2a"}, {"type": "rectangle", "x": 30, "y": 290, "width": 1150, "height": 280, "backgroundColor": "#ebfbee", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0}, {"type": "text", "x": 50, "y": 300, "text": "Agile — ทำเป็นรอบสั้น (Sprint/Cycle 1–4 สัปดาห์) ส่ง increment ที่ใช้ได้จริงทุกรอบ", "fontSize": 18, "fontFamily": "helvetica", "strokeColor": "#2f9e44"}, {"id": "a1", "type": "rectangle", "x": 55, "y": 345, "width": 340, "height": 170, "backgroundColor": "#ffe8cc", "strokeColor": "#e8590c", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Sprint 1\n\nวางแผน → ทำ → ทดสอบ → รีวิว\n↓\nIncrement 1 + feedback"}, {"id": "a2", "type": "rectangle", "x": 430, "y": 345, "width": 340, "height": 170, "backgroundColor": "#ffe8cc", "strokeColor": "#e8590c", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Sprint 2\n\nวางแผน → ทำ → ทดสอบ → รีวิว\n↓\nIncrement 2 + feedback"}, {"id": "a3", "type": "rectangle", "x": 805, "y": 345, "width": 340, "height": 170, "backgroundColor": "#ffe8cc", "strokeColor": "#e8590c", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "fontFamily": "helvetica", "fontSize": 16, "text": "Sprint 3 …\n\nปรับลำดับ backlog จาก feedback\n↓\nIncrement 3 …"}, {"type": "arrow", "x": 400, "y": 430, "width": 25, "height": 0, "startElementId": "a1", "endElementId": "a2", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0}, {"type": "arrow", "x": 775, "y": 430, "width": 25, "height": 0, "startElementId": "a2", "endElementId": "a3", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0}, {"type": "text", "x": 55, "y": 530, "text": "ใน Plane: Sprint = Cycle · Increment = work items ที่อยู่ในกลุ่ม completed · feedback = comment/activity บน work item", "fontSize": 15, "fontFamily": "helvetica", "strokeColor": "#5b6b7f"}]