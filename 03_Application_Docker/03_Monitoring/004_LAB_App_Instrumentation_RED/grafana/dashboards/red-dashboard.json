{
  "uid": "monlab4red",
  "title": "LAB 4 — RED Method (app instrumentation)",
  "tags": ["monlab4", "red", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "monprom" },
        "definition": "label_values(app_requests_total, endpoint)",
        "query": {
          "qryType": 1,
          "query": "label_values(app_requests_total, endpoint)",
          "refId": "endpointVar"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "R — Rate (req/s)",
      "description": "sum(rate(app_requests_total[1m])) — จำนวน request ต่อวินาทีที่แอปรับจริง",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sum(rate(app_requests_total[1m]))",
          "legendFormat": "req/s",
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "E — Error ratio (%)",
      "description": "สัดส่วน request ที่ตอบ 5xx เทียบกับทั้งหมด",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "100 * sum(rate(app_requests_total{status=~\"5..\"}[1m])) / sum(rate(app_requests_total[1m]))",
          "legendFormat": "error %"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "D — p95 latency",
      "description": "histogram_quantile(0.95, ...) — ค่าประมาณจากขอบ bucket ไม่ใช่ค่าจริงเป๊ะ",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Inflight (gauge)",
      "description": "app_inflight_requests — งานที่กำลังค้างอยู่ในมือแอป ณ วินาทีนี้",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "app_inflight_requests",
          "legendFormat": "inflight"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "R — Rate แยกตาม endpoint",
      "description": "sum by (endpoint) (rate(app_requests_total[1m]))",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sum by (endpoint) (rate(app_requests_total{endpoint=~\"$endpoint\"}[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "E — Error ratio ตามเวลา",
      "description": "5xx / ทั้งหมด — ดูเป็นสัดส่วน ไม่ใช่จำนวนดิบ",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sum(rate(app_requests_total{status=~\"5..\"}[1m])) / sum(rate(app_requests_total[1m]))",
          "legendFormat": "error ratio (ทั้งแอป)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sum by (endpoint) (rate(app_requests_total{status=~\"5..\"}[1m])) / sum by (endpoint) (rate(app_requests_total[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "D — p50 / p95 / p99 เทียบกับค่าเฉลี่ย",
      "description": "ค่าเฉลี่ย (_sum/_count) ต่ำกว่า p95 มาก — นี่คือเหตุผลที่ค่าเฉลี่ยหลอกตา",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sum(rate(app_request_duration_seconds_sum[5m])) / sum(rate(app_request_duration_seconds_count[5m]))",
          "legendFormat": "avg (_sum/_count)"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg (_sum/_count)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "D — Heatmap ของ histogram bucket",
      "description": "sum by (le) (rate(app_request_duration_seconds_bucket[1m])) — เห็นการกระจายของเวลาตอบ ไม่ใช่แค่ค่าเดียว",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sum by (le) (rate(app_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "yAxis": { "unit": "s", "axisPlacement": "left" },
        "legend": { "show": true },
        "tooltip": { "mode": "single", "yHistogram": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "rowsFrame": { "layout": "auto" }
      },
      "fieldConfig": { "defaults": { "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gauge — app_inflight_requests",
      "description": "gauge ขึ้นลงได้ ต่างจาก counter ที่ขึ้นอย่างเดียว",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "app_inflight_requests",
          "legendFormat": "inflight"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "max_over_time(app_inflight_requests[5m])",
          "legendFormat": "max ใน 5 นาที"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never", "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cardinality — จำนวนค่าของ label endpoint ที่ยัง active",
      "description": "count(count by (endpoint) (app_requests_total)) — เป็น instant query จึงนับเฉพาะ series ที่ยัง active (ยังไม่ถูกใส่ stale marker) ของ process ปัจจุบัน ไม่ใช่ทุกค่าที่เคยมีมาตลอดกาล · ถ้าเส้นนี้ไต่ขึ้นไม่หยุด แปลว่า label ออกแบบผิด",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "count(count by (endpoint) (app_requests_total))",
          "legendFormat": "จำนวนค่า endpoint"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "count(app_requests_total)",
          "legendFormat": "จำนวน series ของ app_requests_total"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Rate ต่อ endpoint + status (5 นาทีล่าสุด)",
      "description": "ตารางเดียวกันกับ Rate แต่แยก status ให้เห็นว่า 500 มาจาก endpoint ไหน",
      "datasource": { "type": "prometheus", "uid": "monprom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "monprom" },
          "expr": "sort_desc(sum by (endpoint, status) (rate(app_requests_total[5m])))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true }, "renameByName": { "Value": "req/s" } } }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "req/s", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "req/s" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 3.5 }
            ]
          }
        ]
      }
    }
  ]
}
