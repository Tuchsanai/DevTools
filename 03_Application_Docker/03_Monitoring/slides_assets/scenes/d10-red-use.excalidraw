      "height": 100,
      "backgroundColor": "#d0ebff",
      "strokeColor": "#1864ab",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "D — Duration : ช้าแค่ไหน (ดู p95 ไม่ใช่ค่าเฉลี่ย)\nhistogram_quantile(0.95, sum by (le)\n  (rate(app_request_duration_seconds_bucket[5m])))"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:00:06.699Z",
