      "version": 1
    },
    {
      "id": "r2",
      "type": "rectangle",
      "x": 55,
      "y": 250,
      "width": 495,
      "height": 95,
      "backgroundColor": "#d0ebff",
      "strokeColor": "#1864ab",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "E — Errors : พังกี่เปอร์เซ็นต์\nsum(rate(app_requests_total{status=~\"5..\"}[1m]))\n  / sum(rate(app_requests_total[1m]))"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:00:06.699Z",
      "updatedAt": "2026-08-15T16:00:06.699Z",
      "version": 1
    },
