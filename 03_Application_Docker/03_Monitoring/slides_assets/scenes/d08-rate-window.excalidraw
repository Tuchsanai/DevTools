      "strokeColor": "#2f9e44",
      "text": "หน้าต่าง [1m] — มี 5 จุด ใช้ได้",
      "fontSize": 18,
      "fontFamily": 2,
      "createdAt": "2026-08-15T15:59:51.043Z",
