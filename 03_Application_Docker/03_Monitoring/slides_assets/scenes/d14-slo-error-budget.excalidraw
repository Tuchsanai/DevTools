    {
      "id": "use14",
      "type": "rectangle",
      "x": 30,
      "y": 390,
      "width": 1110,
      "height": 125,
      "backgroundColor": "#e7f5ff",
      "strokeColor": "#1864ab",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "ทำไมต้องมีงบ : ระบบที่ไม่เคยพังเลย = ลงทุนเกินจำเป็น (99.99% แพงกว่า 99.9% หลายเท่า)\nError budget เปลี่ยนคำถามจาก \"ห้ามพัง\" เป็น \"พังได้เท่าไร แล้วเราจะใช้โควตานั้นทำอะไร\"\n\nงบเหลือเยอะ → ปล่อยฟีเจอร์ใหม่ได้เร็ว กล้าทดลอง       งบใกล้หมด → หยุดปล่อยของ หันมาแก้ความเสถียรก่อน\nและมันคือเหตุผลว่าทำไม alert ควรผูกกับ \"อาการที่ผู้ใช้เจอ\" ไม่ใช่ \"CPU สูง\" ที่ผู้ใช้อาจไม่รู้สึกอะไรเลย"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:00:37.859Z",
      "updatedAt": "2026-08-15T16:00:37.859Z",
      "version": 1
    }
  ],
