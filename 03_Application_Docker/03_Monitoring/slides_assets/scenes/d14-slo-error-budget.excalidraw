    },
    {
      "id": "sli",
      "type": "rectangle",
      "x": 30,
      "y": 100,
      "width": 355,
      "height": 130,
      "backgroundColor": "#d0ebff",
      "strokeColor": "#1864ab",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "SLI — ตัววัด\n\n\"สัดส่วน request ที่สำเร็จ\nและเร็วกว่า 1 วินาที\"\n\nคือ PromQL หนึ่งบรรทัด"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:00:37.859Z",
      "updatedAt": "2026-08-15T16:00:37.859Z",
      "version": 1
    },
    {
      "id": "slo",
      "type": "rectangle",
      "x": 405,
      "y": 100,
      "width": 355,
      "height": 130,
      "backgroundColor": "#ffe8cc",
      "strokeColor": "#e8590c",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "SLO — เป้าหมาย\n\n\"SLI ต้อง ≥ 99.9%\nวัดต่อเนื่อง 30 วัน\"\n\nคือสัญญาที่ทีมให้ไว้"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:00:37.859Z",
      "updatedAt": "2026-08-15T16:00:37.859Z",
      "version": 1
    },
    {
      "id": "eb",
      "type": "rectangle",
      "x": 780,
      "y": 100,
      "width": 360,
      "height": 130,
      "backgroundColor": "#ffe3e3",
      "strokeColor": "#c92a2a",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "Error Budget — โควตาพัง\n\n100% − 99.9% = 0.1%\nของ 30 วัน = 43 นาที\n\nคือ \"งบ\" ที่ใช้ได้ต่อเดือน"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:00:37.859Z",
      "updatedAt": "2026-08-15T16:00:37.859Z",
      "version": 1
    },
    {
