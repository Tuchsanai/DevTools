    {
      "id": "why",
      "type": "rectangle",
      "x": 40,
      "y": 435,
      "width": 1100,
      "height": 105,
      "backgroundColor": "#e7f5ff",
      "strokeColor": "#1864ab",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "ทำไมต้องรอ for: — เพราะ error กระตุกวินาทีเดียวไม่ควรปลุกใครตอนตี 3\nfor: คือตัวกรอง \"เสียงรบกวน\" ออกจาก \"ปัญหาจริง\" · ตั้งสั้นไป = เตือนพร่ำเพรื่อ · ตั้งยาวไป = รู้ช้าเกินแก้\n\n⏱ การเปลี่ยนสถานะเกิดเฉพาะ \"รอบประเมิน\" (evaluation_interval) เท่านั้น — จึง firing ช้ากว่า for: ที่ตั้งไว้ได้เล็กน้อย"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T16:51:59.042Z",
      "updatedAt": "2026-08-15T16:51:59.042Z",
      "version": 1
    }
