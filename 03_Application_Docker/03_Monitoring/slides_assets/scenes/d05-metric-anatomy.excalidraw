    {
      "id": "ser",
      "type": "rectangle",
      "x": 40,
      "y": 370,
      "width": 1100,
      "height": 145,
      "backgroundColor": "#fff9db",
      "strokeColor": "#e8590c",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "ทำไม labels ถึงสำคัญ : เมื่อรวมกันแล้ว metric ชื่อเดียวกลายเป็นหลายเส้น (series) ที่ query แยกหรือรวมก็ได้\n\napp_requests_total{endpoint=\"/api/items\", status=\"200\"}    ← เส้นที่ 1\napp_requests_total{endpoint=\"/api/items\", status=\"500\"}    ← เส้นที่ 2\napp_requests_total{endpoint=\"/api/slow\",  status=\"200\"}    ← เส้นที่ 3\n\nsum by (status) (rate(app_requests_total[1m]))  →  ยุบทุก endpoint เหลือมองแยกตาม status"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T15:59:27.961Z",
      "updatedAt": "2026-08-15T15:59:27.961Z",
      "version": 1
    }
  ],
