    {
      "id": "msukai7tgb2xdawa9aj",
      "type": "text",
      "x": 790,
      "y": 112,
      "strokeColor": "#5b6b7f",
      "text": "\"ไม่เกิน 0.1 วิ มี 80 ครั้ง\"",
