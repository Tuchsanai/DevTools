      "version": 1
    },
    {
      "id": "msukai7tqzvdjyckli",
      "type": "text",
      "x": 790,
      "y": 202,
      "strokeColor": "#5b6b7f",
      "text": "\"ไม่เกิน 0.5 วิ มี 180 ครั้ง\"",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-15T15:59:43.292Z",
      "updatedAt": "2026-08-15T15:59:43.292Z",
      "version": 1
    },
    {
      "id": "msukai7ti5bsud4u0z8",
      "type": "text",
      "x": 790,
      "y": 247,
      "strokeColor": "#e8590c",
      "text": "\"ไม่เกิน 1 วิ มี 195 ครั้ง\"",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-15T15:59:43.292Z",
      "updatedAt": "2026-08-15T15:59:43.292Z",
      "version": 1
    },
    {
      "id": "msukai7tgy8yo8n3vac",
      "type": "text",
      "x": 790,
      "y": 292,
      "strokeColor": "#2f9e44",
      "text": "ทั้งหมด 200 ครั้ง (= _count)",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-15T15:59:43.292Z",
      "updatedAt": "2026-08-15T15:59:43.292Z",
      "version": 1
    },
    {
      "id": "q",
      "type": "rectangle",
      "x": 40,
      "y": 350,
      "width": 1100,
      "height": 165,
      "backgroundColor": "#fff9db",
      "strokeColor": "#e8590c",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "p95 = ค่าที่ 95% ของ request เร็วกว่าหรือเท่ากับค่านี้ → 95% ของ 200 = 190 ครั้ง\n190 อยู่ระหว่างถัง 0.5 (180 ครั้ง) กับถัง 1.0 (195 ครั้ง)  →  Prometheus ประมาณค่าเชิงเส้นในช่วงนั้น\n\nhistogram_quantile(0.95, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))\n\n⚠️ p95 เป็น \"ค่าประมาณ\" ที่ละเอียดเท่าที่ขอบถังจะบอกได้ — เลือกขอบถังให้คร่อมค่าที่เราสนใจ (เช่น SLO 1 วินาที) เสมอ"
      },
      "fontSize": 17,
      "fontFamily": 2,
      "fillStyle": "solid",
      "createdAt": "2026-08-15T15:59:43.292Z",
      "updatedAt": "2026-08-15T15:59:43.292Z",
      "version": 1
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
