    {
      "id": "msukai7th4iyuzpi11",
      "type": "text",
      "x": 790,
      "y": 157,
      "strokeColor": "#5b6b7f",
      "text": "\"ไม่เกิน 0.25 วิ มี 140 ครั้ง\"  ← รวม 80 ข้างบนแล้ว",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-15T15:59:43.292Z",
