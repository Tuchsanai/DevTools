    {
      "id": "msuk9umqejpf6ilakx8",
      "type": "text",
      "x": 45,
      "y": 265,
      "strokeColor": "#1864ab",
      "text": "✓ Prometheus คุมจังหวะเอง\n✓ รู้ทันทีว่า target ตาย (up=0)\n✓ แอปแค่เปิดหน้าเว็บไว้เฉย ๆ\n✓ ทดสอบด้วย curl ได้เลย",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-15T15:59:12.725Z",
      "updatedAt": "2026-08-15T15:59:12.725Z",
      "version": 1
