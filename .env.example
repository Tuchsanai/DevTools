# ตัวอย่าง .env — คัดลอกเป็น .env แล้วใส่ค่าจริงของตัวเอง (cp .env.example .env)
GIT_USER_NAME="<ชื่อ-นามสกุล หรือ GitHub username>"
GIT_USER_EMAIL="<อีเมลที่ผูกกับ GitHub>"

GITHUB_USER="<GITHUB_USER>"
GITHUB_TOKEN="<GitHub PAT: ghp_...>"
GIT_TOKEN="${GITHUB_TOKEN}"

DOCKER_USER="<DOCKER_USER>"
DOCKER_TOKEN="<Docker Hub access token: dckr_pat_...>"

DOCKERHUB_WEB_USER="<DOCKER_USER>"
DOCKERHUB_WEB_PASSWORD="<รหัสผ่านเว็บ Docker Hub>"
